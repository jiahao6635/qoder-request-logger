# ═══════════════════════════════════════════════════════════════════════════
# Qoder 审计日志收集 Server —— Docker 部署环境变量模板
#
# 用法：cp .env.example .env && vi .env
# ⚠ 安全红线：
#   - .env 含 AK/SK 凭证，权限收紧为 600（chmod 600 .env），严禁提交 Git
#   - api-keys.yml（Key 注册表哈希）放 ./config/api-keys.yml，由 compose 只读挂载，
#     .dockerignore 已确保其不进镜像
# ═══════════════════════════════════════════════════════════════════════════

# ── OSS 基座（runbook §1：共享 Bucket + §1.2 writer 子账号）────────────────
OSS_BUCKET=sigmob-qoder-logs            # 公司共享日志 Bucket 名（必填）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com # 与 Bucket 同地域，优先内网 Endpoint（必填）

# ── 服务端加密（runbook §3.5 第 6 项：生产必须 kms，勿降级为 none）─────────
OSS_ENCRYPTION=kms                       # none | aes256 | kms
OSS_KMS_KEY_ID=                          # 专属 CMK 的 key-id；OSS_ENCRYPTION=kms 时必填（留空则启动即失败）

# ── AK/SK（§1.2 qoder-log-writer 子账号；仅环境变量注入，不走配置文件）─────
OSS_AK_ID=                               # 必填；OSS_MODE=oss 时启动校验非空
OSS_AK_SECRET=                           # 必填；同上

# ── 可选覆盖（默认值即生产推荐，见 docker-compose.yml）─────────────────────
#SERVER_PORT=8080                         # 宿主机暴露端口（容器内固定 8080）
#JAVA_OPTS=-XX:+UseG1GC -Xms1g -Xmx3g     # JVM 参数（容器内存预算内调整）

# ── 本地联调（无 OSS 环境，写本地目录模拟 OSS；生产勿用）───────────────────
#OSS_MODE=file                            # oss=生产直传 | file=本地联调
#OSS_FILE_STORAGE_DIR=/data/oss-storage   # file 模式落盘根目录（容器内路径，需自行挂载）

# ── 高级：audit.* 运行参数均可在此覆盖（默认值=生产推荐，见 docker-compose.yml）──
# 联调时可加速验证，例：
#AUDIT_CLOSE_IDLE_SECONDS=3               # 段静默滚动阈值（生产 600）
#AUDIT_UPLOAD_INTERVAL_SECONDS=3          # 上传调度周期（生产 30）
# 其余可覆盖键：AUDIT_API_KEYS_FILE / AUDIT_SPOOL_DIR / AUDIT_ROTATE_SIZE_MB /
#   AUDIT_RATE_LIMIT_PER_KEY / AUDIT_MAX_BODY_MB / AUDIT_DISK_HIGH_WATERMARK

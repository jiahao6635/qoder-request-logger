# ── 凭证与本地配置：绝不进镜像/构建上下文（安全红线）──────────────────────
.env
.env.*
config/

# ── 宿主构建产物：镜像内多阶段构建自包含，宿主 target 只会撑大上下文 ─────
target/

# ── 版本控制 / 文档 / IDE 杂项 ──────────────────────────────────────────────
.git
.gitignore
*.md
docs/
.idea/
.vscode/
.DS_Store

# ── 编排文件本身不参与构建（修改 compose 不应失效镜像层缓存）──────────────
docker-compose*.yml
.dockerignore

# ── 本地联调/临时产物 ───────────────────────────────────────────────────────
*.log
.tmp-*
oss-storage/
mock-out/
